{
  "mcpServers": {
    "blender": {
      "command": "/home/linuxbrew/.linuxbrew/bin/uvx",
      "args": [
        "--python",
        "3.11",
        "blender-mcp"
      ],
      "env": {
        "BLENDER_HOST": "localhost",
        "BLENDER_PORT": "9876",
        "UV_PYTHON_PREFERENCE": "only-managed",
        "DISABLE_TELEMETRY": "true",
        "PATH": "/home/linuxbrew/.linuxbrew/bin:/home/leon/.local/bin:/usr/bin:/bin"
      }
    }
  }
}
